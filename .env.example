# =====================================================================
#  JLK Fitness e Casual — variáveis de ambiente
# =====================================================================
#  Copie este arquivo para .env.local e preencha os valores:
#
#      cp .env.example .env.local
#
#  ⚠️ NUNCA faça commit do .env.local (ele já está no .gitignore).
#     Variáveis que começam com NEXT_PUBLIC_ ficam visíveis no navegador;
#     as demais (como DATABASE_URL) ficam só no servidor.
# =====================================================================


# ---------------------------------------------------------------------
#  BANCO DE DADOS — PostgreSQL
# ---------------------------------------------------------------------
#  Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
#  Exemplos:
#    Local ............ postgresql://postgres:sua_senha@localhost:5432/jlk_loja
#    Supabase ......... postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#    Neon ............. postgresql://usuario:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/jlk_loja?sslmode=require
#
#  Se a senha tiver caracteres especiais (@ : / # ?), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/jlk_loja

#  SSL da conexão:
#    false ....... banco local (padrão)
#    true ........ bancos na nuvem (Supabase, Neon, RDS...) — verifica o certificado
#    no-verify ... nuvem com certificado próprio (evite em produção)
DATABASE_SSL=false

#  Máximo de conexões simultâneas abertas pelo servidor
DATABASE_POOL_MAX=10


# ---------------------------------------------------------------------
#  AUTENTICAÇÃO — JWT da Área do Vendedor
# ---------------------------------------------------------------------
#  Segredo usado para assinar os tokens. Mínimo 32 caracteres, aleatório.
#  Gere um com:   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#  ⚠️ Se este valor vazar, troque-o: todos os tokens antigos deixam de valer.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

#  Tempo de validade do token (ex.: 3h, 90m, 1d). Padrão: 3h
JWT_EXPIRACAO=3h


# ---------------------------------------------------------------------
#  IMAGENS ENVIADAS (tela "Carregar imagens")
# ---------------------------------------------------------------------
#  Pasta onde os arquivos são gravados. No Railway, aponte para o volume (ex.: /data/imagens).
#  Vazio = ./uploads (desenvolvimento local)
UPLOADS_DIR=

#  Tamanho máximo de cada imagem, em MB
IMAGEM_TAMANHO_MAX_MB=5


# ---------------------------------------------------------------------
#  LOJA
# ---------------------------------------------------------------------
#  Número do WhatsApp que recebe os pedidos (código do país + DDD + número, só dígitos)
#  Exemplo: 5511987654321
NEXT_PUBLIC_WHATSAPP_NUMERO=

#  Endereço público do site (usado nas prévias de link do WhatsApp/Instagram)
#  Exemplo: https://www.jlkfitness.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

#  E-mail para contato e pedidos sobre dados pessoais (aparece na Política de Privacidade)
NEXT_PUBLIC_EMAIL_CONTATO=

#  CNPJ da loja (aparece no rodapé e na Política de Privacidade). Ex.: 12.345.678/0001-90
NEXT_PUBLIC_CNPJ=


# ---------------------------------------------------------------------
#  PRIMEIRO ADMINISTRADOR (usado só no deploy: npm run db:deploy)
# ---------------------------------------------------------------------
#  Se o banco não tiver nenhum vendedor, o pré-deploy cria este administrador.
#  Depois do primeiro acesso, troque a senha em "Meu perfil" e pode apagar ADMIN_SENHA_INICIAL.
ADMIN_LOGIN=admin
ADMIN_NOME=Administrador
ADMIN_TELEFONE=11900000000
ADMIN_SENHA_INICIAL=


# ---------------------------------------------------------------------
#  FRETE — Melhor Envio
# ---------------------------------------------------------------------
#  Ambiente: sandbox (testes) ou producao
MELHORENVIO_AMBIENTE=sandbox

#  URL da API: https://sandbox.melhorenvio.com.br (testes) ou https://melhorenvio.com.br (produção)
MELHORENVIO_API_URL=https://sandbox.melhorenvio.com.br

#  Aplicativo cadastrado no painel do Melhor Envio (Configurações → Aplicativos)
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=

#  URL da loja onde o Melhor Envio devolve a autorização (OAuth)
#  Testes: https://loja-teste-jk.up.railway.app/api/frete/melhorenvio/callback
MELHORENVIO_REDIRECT_URI=

#  CEP de onde os pedidos saem (só números). Vazio = CEP do primeiro local de retirada (vendedor)
MELHORENVIO_CEP_ORIGEM=

#  Token de acesso (gerado pelo OAuth ou em Configurações → Tokens)
MELHORENVIO_TOKEN=

#  O Melhor Envio exige User-Agent com nome da aplicação e e-mail técnico
#  Exemplo: JLK Fitness (contato@jlkfitness.com.br)
MELHORENVIO_USER_AGENT=

#  Quando gerar a etiqueta (e a DC-e) dos pedidos "Receber em casa":
#    pedido    = assim que o cliente envia o pedido (testes: sem esperar o pagamento)
#    aprovacao = quando o vendedor aprova o pagamento (recomendado em produção: a etiqueta é paga de verdade)
#  Vazio: "pedido" no sandbox e "aprovacao" na produção
MELHORENVIO_GERAR_ETIQUETA=
