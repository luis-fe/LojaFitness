# =====================================================================
#  JLK Fitness e Casual — variáveis de ambiente
# =====================================================================
#  Copie este arquivo para .env.local e preencha os valores:
#
#      cp .env.example .env.local
#
#  ⚠️ NUNCA faça commit do .env.local (ele já está no .gitignore).
#     Variáveis que começam com NEXT_PUBLIC_ ficam visíveis no navegador;
#     as demais (como DATABASE_URL) ficam só no servidor.
# =====================================================================


# ---------------------------------------------------------------------
#  BANCO DE DADOS — PostgreSQL
# ---------------------------------------------------------------------
#  Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
#  Exemplos:
#    Local ............ postgresql://postgres:sua_senha@localhost:5432/jlk_loja
#    Supabase ......... postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#    Neon ............. postgresql://usuario:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/jlk_loja?sslmode=require
#
#  Se a senha tiver caracteres especiais (@ : / # ?), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/jlk_loja

#  SSL da conexão:
#    false ....... banco local (padrão)
#    true ........ bancos na nuvem (Supabase, Neon, RDS...) — verifica o certificado
#    no-verify ... nuvem com certificado próprio (evite em produção)
DATABASE_SSL=false

#  Máximo de conexões simultâneas abertas pelo servidor
DATABASE_POOL_MAX=10


# ---------------------------------------------------------------------
#  LOJA
# ---------------------------------------------------------------------
#  Número do WhatsApp que recebe os pedidos (código do país + DDD + número, só dígitos)
#  Exemplo: 5511987654321
NEXT_PUBLIC_WHATSAPP_NUMERO=

#  Endereço público do site (usado nas prévias de link do WhatsApp/Instagram)
#  Exemplo: https://www.jlkfitness.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
